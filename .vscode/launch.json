{
  // Pick a configuration under Run and Debug and press F5. The iOS and Android
  // ones start a simulator or an emulator if none is running.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile · macOS",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/mobile",
      "program": "lib/main.dart",
      "deviceId": "macos"
    },
    {
      "name": "Mobile · iOS Simulator",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/mobile",
      "program": "lib/main.dart",
      "emulatorId": "apple_ios_simulator"
    },
    {
      "name": "Mobile · Android Emulator",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/mobile",
      "program": "lib/main.dart",
      // Matches the first virtual device with its API level in the name, the
      // way Android Studio names them. `flutter emulators` lists the ids.
      "emulatorId": "API"
    },
    {
      "name": "Web · localhost:8080",
      "type": "node-terminal",
      "request": "launch",
      "command": "make run-web",
      "serverReadyAction": {
        "pattern": "Serving at http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Mobile · all three",
      "configurations": [
        "Mobile · macOS",
        "Mobile · iOS Simulator",
        "Mobile · Android Emulator"
      ],
      "stopAll": true
    }
  ]
}
