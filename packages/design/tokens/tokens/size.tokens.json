{
  "radius": {
    "$type": "dimension",
    "xs": { "$value": { "value": 8, "unit": "px" } },
    "sm": { "$value": { "value": 12, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 22, "unit": "px" } },
    "xl": { "$value": { "value": 28, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "space": {
    "$type": "dimension",
    "xxs": { "$value": { "value": 4, "unit": "px" } },
    "xs": { "$value": { "value": 8, "unit": "px" } },
    "sm": { "$value": { "value": 12, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 20, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "xxl": { "$value": { "value": 32, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$description": "The smallest tap area.", "$value": { "value": 44, "unit": "px" } },
    "navBar": { "$value": { "value": 64, "unit": "px" } },
    "scrollEdge": { "$description": "How deep a list fades where it goes under a header or a button that stays in place.", "$value": { "value": 48, "unit": "px" } },
    "badge": { "$description": "The height of the count on the corner of a button, such as the new notices on the bell.", "$value": { "value": 20, "unit": "px" } }
  }
}
