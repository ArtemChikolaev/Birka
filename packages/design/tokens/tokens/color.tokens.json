{
  "color": {
    "$type": "color",
    "$description": "Colors of the dark theme. The palette holds raw values; everything else names a role.",
    "palette": {
      "black": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1, "hex": "#000000" } },
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" } },
      "ink": { "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.949], "alpha": 1, "hex": "#f4f4f2" } },
      "gray900": { "$value": { "colorSpace": "srgb", "components": [0.0549, 0.0549, 0.0588], "alpha": 1, "hex": "#0e0e0f" } },
      "gray850": { "$value": { "colorSpace": "srgb", "components": [0.0863, 0.0863, 0.0902], "alpha": 1, "hex": "#161617" } },
      "gray800": { "$value": { "colorSpace": "srgb", "components": [0.1176, 0.1176, 0.1216], "alpha": 1, "hex": "#1e1e1f" } },
      "gray500": { "$value": { "colorSpace": "srgb", "components": [0.5412, 0.5412, 0.5412], "alpha": 1, "hex": "#8a8a8a" } },
      "gray400": { "$value": { "colorSpace": "srgb", "components": [0.6392, 0.6392, 0.6392], "alpha": 1, "hex": "#a3a3a3" } },
      "gray300": { "$value": { "colorSpace": "srgb", "components": [0.7882, 0.7882, 0.7804], "alpha": 1, "hex": "#c9c9c7" } },
      "emerald400": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.8627, 0.5922], "alpha": 1, "hex": "#3ddc97" } },
      "emerald700": { "$value": { "colorSpace": "srgb", "components": [0.1412, 0.5412, 0.3373], "alpha": 1, "hex": "#248a56" } },
      "emerald950": { "$value": { "colorSpace": "srgb", "components": [0.0078, 0.0745, 0.0431], "alpha": 1, "hex": "#02130b" } },
      "coral400": { "$value": { "colorSpace": "srgb", "components": [1, 0.5569, 0.498], "alpha": 1, "hex": "#ff8e7f" } },
      "green": { "$value": { "colorSpace": "srgb", "components": [0.2902, 0.8706, 0.502], "alpha": 1, "hex": "#4ade80" } },
      "amber": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.749, 0.1412], "alpha": 1, "hex": "#fbbf24" } },
      "sky": { "$value": { "colorSpace": "srgb", "components": [0.3765, 0.6471, 0.9804], "alpha": 1, "hex": "#60a5fa" } },
      "violet": { "$value": { "colorSpace": "srgb", "components": [0.6549, 0.5451, 0.9804], "alpha": 1, "hex": "#a78bfa" } },
      "rose": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.4431, 0.5216], "alpha": 1, "hex": "#fb7185" } },
      "orange": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.5725, 0.2353], "alpha": 1, "hex": "#fb923c" } },
      "cyan": { "$value": { "colorSpace": "srgb", "components": [0.1333, 0.8275, 0.9333], "alpha": 1, "hex": "#22d3ee" } },
      "slate": { "$value": { "colorSpace": "srgb", "components": [0.2275, 0.2275, 0.2353], "alpha": 1, "hex": "#3a3a3c" } }
    },
    "background": { "$value": "{color.palette.black}" },
    "surface": { "$value": "{color.palette.gray900}" },
    "surfaceRaised": { "$value": "{color.palette.gray850}" },
    "surfaceSelected": { "$value": "{color.palette.gray800}" },
    "text": { "$value": "{color.palette.ink}" },
    "textSecondary": { "$value": "{color.palette.gray300}" },
    "textMuted": { "$value": "{color.palette.gray400}" },
    "textSubtle": { "$value": "{color.palette.gray500}" },
    "accent": { "$value": "{color.palette.emerald400}" },
    "onAccent": { "$value": "{color.palette.emerald950}" },
    "accentHighlight": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.45, "hex": "#ffffff" } },
    "accentSoft": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.8627, 0.5922], "alpha": 0.14, "hex": "#3ddc97" } },
    "ambient": { "$description": "The glow in the corners of every screen.", "$value": { "colorSpace": "srgb", "components": [0.1412, 0.5412, 0.3373], "alpha": 0.3, "hex": "#248a56" } },
    "positive": { "$value": "{color.palette.emerald400}" },
    "negative": { "$value": "{color.palette.coral400}" },
    "hairline": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.09, "hex": "#ffffff" } },
    "glass": {
      "$description": "Liquid Glass surfaces: a light gradient fill over a backdrop blur, a hairline border and a highlight on the top edge.",
      "fillTop": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.1, "hex": "#ffffff" } },
      "fillBottom": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.03, "hex": "#ffffff" } },
      "border": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.14, "hex": "#ffffff" } },
      "highlight": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.18, "hex": "#ffffff" } }
    },
    "nav": {
      "fill": { "$value": { "colorSpace": "srgb", "components": [0.1255, 0.1255, 0.1333], "alpha": 0.52, "hex": "#202022" } },
      "highlight": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.22, "hex": "#ffffff" } },
      "lowlight": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.05, "hex": "#ffffff" } },
      "bubble": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.13, "hex": "#ffffff" } },
      "bubbleHighlight": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.28, "hex": "#ffffff" } },
      "label": { "$value": { "colorSpace": "srgb", "components": [0.7059, 0.7059, 0.698], "alpha": 1, "hex": "#b4b4b2" } }
    }
  }
}
